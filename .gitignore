
# ==========================================
# MINIPEDIDOS V2 - GITIGNORE
# ==========================================

# Archivos Java compilados
*.class

# Archivos de registro
*.log

# Archivos BlueJ
*.ctxt

# Herramientas Java ME
.mtj.tmp/

# Paquetes y archivos comprimidos
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Archivos de errores de la JVM
hs_err_pid*
replay_pid*

# ==========================================
# MAVEN
# ==========================================

/target/

# ==========================================
# SESION 3 - PARTE 3
# BASE DE DATOS H2
# ==========================================

# Datos persistentes de usuarios
/data/

# Archivos generados por H2
*.mv.db
*.trace.db

# ==========================================
# SEGURIDAD
# ==========================================

# Variables de entorno privadas
.env
.env.*
!.env.example

# Archivos locales de credenciales
*.secrets
*.credentials

# ==========================================
# RESPALDOS LOCALES
# ==========================================

/docker-compose.backup.yml

# Archivos temporales de Python
__pycache__/
*.pyc
